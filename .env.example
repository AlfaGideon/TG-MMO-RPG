# Telegram Bot
BOT_TOKEN=your_telegram_bot_token_here
ADMIN_IDS=123456789,987654321

# Proxy for the bot ONLY (Telegram API). Leave empty for direct connection.
#   socks5://127.0.0.1:9050  - system Tor service
#   socks5://127.0.0.1:9150  - Tor Browser
TELEGRAM_PROXY_URL=

# Admin Panel
ADMIN_HOST=0.0.0.0
ADMIN_PORT=8000
ADMIN_SECRET_KEY=super-secret-key-change-me

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/game.db

# Game Settings
EXP_RATE=1.0
DROP_RATE=1.0
GOLD_RATE=1.0

# SSH-туннель для Telegram Mini App (1=on, 0=off).
# Панель использует системный SSH-клиент для создания безопасного туннеля
# через serveo.net или localhost.run и сохраняет публичный URL в настройки.
# Отключи, если размещаешь панель на хостинге (тогда укажи PUBLIC_URL).
#
# Адрес туннеля одноразовый: он меняется при каждом перезапуске сервера.
# Поэтому сервер сбрасывает сохранённый адрес при старте и публикует новый
# только после того, как /health подтвердит доступность процесса. Если тебе
# нужен постоянный адрес, используй PUBLIC_URL ниже.
ADMIN_TUNNEL=1

# Manual public URL of the admin panel (e.g. https://your-app.onrender.com).
# When set, the Quick Tunnel is not started. Render's RENDER_EXTERNAL_URL and
# Replit's REPLIT_DEV_DOMAIN are detected automatically, so do not copy a
PUBLIC_URL=
