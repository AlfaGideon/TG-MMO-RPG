# Telegram Bot
BOT_TOKEN=your_telegram_bot_token_here
ADMIN_IDS=123456789,987654321

# Proxy for the bot ONLY (Telegram API). Leave empty for direct connection.
#   socks5://127.0.0.1:9050  - system Tor service
#   socks5://127.0.0.1:9150  - Tor Browser
TELEGRAM_PROXY_URL=

# Admin Panel
ADMIN_HOST=0.0.0.0
ADMIN_PORT=8000
ADMIN_SECRET_KEY=super-secret-key-change-me

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/game.db

# Game Settings
EXP_RATE=1.0
DROP_RATE=1.0
GOLD_RATE=1.0

# Cloudflare Quick Tunnel for the admin panel Mini App (1=on, 0=off).
# The panel auto-downloads cloudflared on first start, opens an HTTPS
# tunnel and saves the public URL into panel settings. Turn off if you
# host the panel yourself (then set PUBLIC_URL instead).
#
# The tunnel address is single-use: it dies with the cloudflared process,
# the previous one starts answering with Cloudflare error 1033. The server
# therefore drops the stored address on startup and only publishes a new
# one after /health confirms it reaches this very process. If you need a
# stable link that survives restarts, set PUBLIC_URL below instead.
ADMIN_TUNNEL=0

# Manual public URL of the admin panel (e.g. https://your-app.onrender.com).
# When set, the Quick Tunnel is not started. Render's RENDER_EXTERNAL_URL and
# Replit's REPLIT_DEV_DOMAIN are detected automatically, so do not copy a
PUBLIC_URL=
